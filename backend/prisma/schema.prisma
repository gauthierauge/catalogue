generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BookType {
  NOVEL
  COMIC
  MANGA
  ESSAY
  BIOGRAPHY
  MANUAL
}

enum BookGenre {
  SCIENCE_FICTION
  FANTASY
  CRIME
  ROMANCE
  HORROR
  ADVENTURE
  HISTORY
  YOUNG_ADULT
  CHILDREN
  NON_FICTION
}

model Author {
  id        Int    @id @default(autoincrement())
  lastname  String
  firstname String
  books     Book[]
}

model Book {
  id              Int       @id @default(autoincrement())
  title           String
  price           Float
  description     String?
  authors         Author[]
  publisherName   String?
  quantity        Int       @default(0)
  type            BookType
  genre           BookGenre
  isbn            String    @unique
  publicationDate DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  stockEvents     StockEvent[]
}

model StockEvent {
  id             Int      @id @default(autoincrement())
  idempotencyKey String   @unique
  paymentId      String?
  bookId         Int
  status         String
  quantity       Int
  resultQuantity Int
  createdAt      DateTime @default(now())
  book           Book     @relation(fields: [bookId], references: [id])
}
